{
  "name": "Salesforce Inspector Advanced",
  "description": "Productivity tools for Salesforce administrators and developers to inspect data and metadata directly from the Salesforce UI.",
  "version": "1.42",
  "version_name": "1.42",
  "icons": {
    "128": "icon128.png"
  },
  "minimum_chrome_version": "88",
  "permissions": [
    "cookies",
    "storage"
  ],
  "action": {
    "default_title": "Salesforce Inspector Advanced - Orgs",
    "default_popup": "org-launcher.html"
  },
  "commands": {
    "data-export": {
      "description": "Export data"
    },
    "data-import": {
      "description": "Import data"
    },
    "data-transfer": {
      "description": "Transfer data between orgs"
    },
    "apex-runner": {
      "description": "Run apex code"
    },
    "apex-code": {
      "description": "Browse apex code & coverage"
    },
    "streaming": {
      "description": "Manage streaming"
    },
    "metadata-retrieve": {
      "description": "Retrieve metadata"
    },
    "dependency": {
      "description": "Explore dependencies"
    },
    "explore-api": {
      "description": "Explore API"
    },
    "limits": {
      "description": "Org limits"
    },
    "org-analyzer": {
      "description": "Analyze org"
    },
    "options": {
      "description": "Options"
    }
  },
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.force.com/*",
    "https://*.cloudforce.com/*",
    "https://*.visualforce.com/*",
    "https://*.sfcrmapps.cn/*",
    "https://*.sfcrmproducts.cn/*",
    "https://*.salesforce.mil/*",
    "https://*.force.mil/*",
    "https://*.cloudforce.mil/*",
    "https://*.visualforce.mil/*",
    "https://*.crmforce.mil/*",
    "https://*.force.com.mcas.ms/*",
    "https://*.salesforce-setup.com/*",
    "https://*.builder.salesforce-experience.com/*",
    "https://api.openai.com/*",
    "https://api.mistral.ai/*",
    "https://api.anthropic.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.visual.force.com/*",
        "https://*.vf.force.com/*",
        "https://*.lightning.force.com/*",
        "https://*.cloudforce.com/*",
        "https://*.visualforce.com/*",
        "https://*.sfcrmapps.cn/*",
        "https://*.sfcrmproducts.cn/*",
        "https://*.salesforce.mil/*",
        "https://*.visual.force.mil/*",
        "https://*.vf.force.mil/*",
        "https://*.lightning.force.mil/*",
        "https://*.cloudforce.mil/*",
        "https://*.visualforce.mil/*",
        "https://*.crmforce.mil/*",
        "https://*.lightning.force.com.mcas.ms/*",
        "https://*.salesforce-setup.com/*",
        "https://*.builder.salesforce-experience.com/*",
        "https://*.force.com/*"
      ],
      "all_frames": true,
      "css": [
        "button.css",
        "inspect-inline.css"
      ],
      "js": [
        "button.js",
        "inspect-inline.js",
        "formula-inline.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "popup.html",
        "apex-runner.html",
        "apex-code.html",
        "log.html",
        "streaming.html",
        "data-export.html",
        "data-import.html",
        "data-transfer.html",
        "inspect.html",
        "metadata-retrieve.html",
        "explore-api.html",
        "limits.html",
        "formula-helper.html",
        "options.html",
        "dependency.html",
        "org-analyzer.html"
      ],
      "matches": [
        "https://*.salesforce.com/*",
        "https://*.visual.force.com/*",
        "https://*.vf.force.com/*",
        "https://*.lightning.force.com/*",
        "https://*.cloudforce.com/*",
        "https://*.visualforce.com/*",
        "https://*.sfcrmapps.cn/*",
        "https://*.sfcrmproducts.cn/*",
        "https://*.salesforce.mil/*",
        "https://*.visual.force.mil/*",
        "https://*.vf.force.mil/*",
        "https://*.lightning.force.mil/*",
        "https://*.cloudforce.mil/*",
        "https://*.visualforce.mil/*",
        "https://*.crmforce.mil/*",
        "https://*.lightning.force.com.mcas.ms/*",
        "https://*.salesforce-setup.com/*",
        "https://*.builder.salesforce-experience.com/*",
        "https://*.force.com/*"
      ],
      "extension_ids": []
    }
  ],
  "incognito": "split",
  "manifest_version": 3
}
